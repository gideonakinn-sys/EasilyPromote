PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000

# Brevo (email)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=YourApp

# Frontend origins (comma-separated)
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# TikTok (Login Kit + Display API)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://<host>/api/tiktok/callback
TIKTOK_FRONTEND_RETURN_URL=http://localhost:3001
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.list
TIKTOK_TOKEN_KEY=your_32_byte_hex_key
TIKTOK_STATE_SECRET=your_state_secret
