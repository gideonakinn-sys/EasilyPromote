PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (retained for legacy read-only / migration)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (presigned-URL uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000

# Brevo (email)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=YourApp

# Frontend origins (comma-separated)
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://easilypromote.com,https://www.easilypromote.com,https://app.easilypromote.com,https://admin.easilypromote.com

# TikTok (Login Kit + Display API)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://<host>/api/tiktok/callback
TIKTOK_FRONTEND_RETURN_URL=http://localhost:3001
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.list
TIKTOK_TOKEN_KEY=your_32_byte_hex_key
TIKTOK_STATE_SECRET=your_state_secret

# Shared encryption key for social tokens at rest (falls back to TIKTOK_TOKEN_KEY).
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key

# Meta — shared
# Graph API version used for all Facebook/Instagram Graph calls.
META_GRAPH_VERSION=v26.0
# Where the OAuth callback returns the user in the frontend (creator app origin).
META_FRONTEND_RETURN_URL=http://localhost:3001
# CSRF/state signing secret for the OAuth round-trip (falls back to JWT_SECRET).
META_STATE_SECRET=your_state_secret

# Meta — Instagram (Instagram API with Instagram Login / Business Login)
# NOTE: this is the *Instagram App ID/Secret* from the Instagram product, NOT the Facebook app id.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://<host>/api/meta/callback/instagram
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Meta — Facebook (Facebook Login + Graph API for Pages)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://<host>/api/meta/callback/facebook
FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,read_insights,business_management
